{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "live-alone-website",
	"compatibility_date": "2026-09-20",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"main": "vinext/server/fetch-handler",
	"assets": {
		"directory": "dist/client",
		"not_found_handling": "none",
		"binding": "ASSETS"
	},
	"images": {
		"binding": "IMAGES"
	},
	"version_metadata": {
		"binding": "CF_VERSION_METADATA"
	},
	"cache": {
		"enabled": false
	},
	"services": [
		{
			"binding": "RESPONSE_STORE",
			"service": "live-alone-website-response-store",
			"entrypoint": "ResponseStoreService"
		}
	],
	"r2_buckets": [
		{
			"bucket_name": "live-alone-website-response-store-cache-bodies",
			"binding": "live_alone_website_response_store_cache_bodies"
		}
	]
}